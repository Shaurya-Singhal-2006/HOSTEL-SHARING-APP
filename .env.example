# Required: normal local PostgreSQL database. `npm run dev` uses this value from apps/api/.env.
DATABASE_URL="postgresql://postgres:password@localhost:5432/lendloop?schema=public"
# Optional: API port (defaults to 4000).
PORT=4000
# Required: comma-separated frontend origins accepted by the API CORS policy.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: API origin used for OAuth callback URLs (defaults to http://localhost:4000).
API_ORIGIN=http://localhost:4000
# Optional: public API origin used to build image URLs (defaults to http://localhost:4000).
API_PUBLIC_URL=http://localhost:4000
# Optional: photo storage path (defaults to ./uploads).
UPLOAD_DIR=./uploads
# Required: Google OAuth web client ID.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Required: Google OAuth web client secret. Keep this server-side; never use a VITE_ variable.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Required: random session signing secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional runtime mode; npm run dev always uses development.
NODE_ENV=development
# Optional: Pino level; defaults to debug in development and info in production.
LOG_LEVEL=debug
# Optional: request timeout in milliseconds (defaults to 15000).
API_REQUEST_TIMEOUT_MS=15000
# Optional: PostgreSQL readiness timeout in milliseconds (defaults to 2500).
API_HEALTH_TIMEOUT_MS=2500
# Optional: PostgreSQL startup timeout in milliseconds (defaults to 10000).
DATABASE_STARTUP_TIMEOUT_MS=10000
# Optional: rate and open-post limits. Defaults are generous in development and stricter in production.
# WANTED_CREATE_LIMIT_PER_HOUR=1000
# WANTED_MAX_OPEN_POSTS=1000
# Community and safety limits default to 1000 in development and strict values in production.
# COMMUNITY_CREATE_LIMIT_PER_HOUR=1000
# COMMUNITY_MAX_ADMIN_COMMUNITIES=1000
# COMMUNITY_JOIN_LIMIT_PER_15_MINUTES=1000
# ITEM_CREATE_LIMIT_PER_HOUR=1000
# REQUEST_CREATE_LIMIT_PER_HOUR=1000
# FEEDBACK_LIMIT_PER_HOUR=1000
# REPORT_LIMIT_PER_HOUR=1000
# Internal: dev:demo sets this to true for its isolated demo process. Keep false for normal use.
DEMO_MODE=false
# Internal: dev:demo uses this only to check that its database differs from the source database.
# DEMO_SOURCE_DATABASE_URL=postgresql://postgres:password@localhost:5432/lendloop?schema=public
# Optional legacy seed input; used only by the developer compatibility seed for My Community.
# HOSTEL_INVITE_CODE=ABCD2345
# Optional demo seed override. Use only a dedicated `_demo` database; otherwise the seed derives lendloop_demo.
# DEMO_DATABASE_URL=postgresql://postgres:password@localhost:5432/lendloop_demo?schema=public
# Optional API smoke-test URL. Must target a separate disposable database ending in `_test`.
# SMOKE_DATABASE_URL=postgresql://postgres:password@localhost:5432/lendloop_test?schema=public
