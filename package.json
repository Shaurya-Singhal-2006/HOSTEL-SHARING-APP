{
  "name": "lendloop",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @lendloop/web",
    "dev:api": "npm run dev -w @lendloop/api",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "npm run db:migrate -w @lendloop/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @lendloop/api",
    "db:seed": "npm run db:seed -w @lendloop/api",
    "db:seed:demo": "npm run db:seed:demo -w @lendloop/api --",
    "db:deploy": "npm run db:deploy -w @lendloop/api",
    "test:smoke": "npm run test:smoke -w @lendloop/api",
    "test:api": "npm run test -w @lendloop/api",
    "dev:demo": "node scripts/dev-demo.mjs",
    "setup": "node scripts/setup.mjs",
    "kill-ports": "node scripts/kill-ports.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1"
  }
}
